# Настройки сборки через внутренние зеркала.
#
#   cp .env.example .env      и подставьте адреса своего Nexus
#
# docker compose читает .env из этого каталога автоматически.
# Пустые значения означают сборку напрямую с Docker Hub, PyPI и npmjs —
# именно так собирается образ на машине разработчика.

# --- Docker Hub -------------------------------------------------------------
#
# Предпочтительный способ — подключить Nexus как registry-mirror в настройках
# демона. Тогда имена базовых образов остаются прежними, digest проверяется
# как обычно, и эта переменная не нужна.
#
# Переменная нужна, только если зеркало приходится указывать именем образа.
# Обязательно со слэшем на конце. Возможно, потребуется добавить library/ —
# зависит от того, как настроен docker proxy repository в Nexus.
#
# WDWS_REGISTRY=nexus.corp:8082/
WDWS_REGISTRY=

# --- npm --------------------------------------------------------------------
#
# Адрес npm proxy repository в Nexus, со слэшем на конце.
#
# WDWS_NPM_REGISTRY=https://nexus.corp/repository/npm-proxy/
WDWS_NPM_REGISTRY=

# --- pip --------------------------------------------------------------------
#
# Адрес pypi proxy repository в Nexus. Обратите внимание на /simple в конце —
# без него pip не найдёт индекс.
#
# WDWS_PIP_INDEX_URL=https://nexus.corp/repository/pypi-proxy/simple
#
# TRUSTED_HOST нужен, только если Nexus отдаётся по http или с сертификатом,
# которому не доверяет образ. По возможности лучше починить сертификат,
# а не отключать проверку.
#
# WDWS_PIP_TRUSTED_HOST=nexus.corp
WDWS_PIP_INDEX_URL=
WDWS_PIP_TRUSTED_HOST=

# --- порт публикации --------------------------------------------------------
# WDWS_PORT=8080
